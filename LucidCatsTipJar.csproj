<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>LucidCatsTipJar</AssemblyName>
    <RootNamespace>LucidCatsTipJar</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.3.2</Version>
    <Description>Adds a tipjar to the lobby through which people can share cash.</Description>
    <Company>MaxMen11</Company>

    <GameDir>$([MSBuild]::GetRegistryValue('HKEY_CURRENT_USER\Software\Valve\Steam','SteamPath'))\steamapps\common\Lucid Cats</GameDir>

    <ManagedDir>$(GameDir)\LucidCats_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />

    <Reference Include="$(GameDir)/LucidCats_Data/Managed/*.dll" Private="false"
               Exclude="$(GameDir)/LucidCats_Data/Managed/mscorlib.dll;$(GameDir)/LucidCats_Data/Managed/System*.dll;$(GameDir)/LucidCats_Data/Managed/Mono.*.dll;$(GameDir)/LucidCats_Data/Managed/netstandard.dll;$(GameDir)/LucidCats_Data/Managed/I18N*.dll" />

    <Reference Include="$(GameDir)/BepInEx/core/*.dll" Private="false"
               Exclude="$(GameDir)/BepInEx/core/0Harmony20.dll" />
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\LucidCatsTipJar" />
    <Message Importance="high" Text="Mod copied to $(BepInExDir)\plugins\LucidCatsTipJar" />
  </Target>
</Project>
